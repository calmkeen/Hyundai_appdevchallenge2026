# 서버에서만 사용. APK에는 OpenAI 키를 넣지 않습니다.
CARCUE_MODE=MOCK
CARCUE_AI_PROVIDER=DISABLED
CARCUE_LOCAL_MODEL=qwen3:4b
CARCUE_LOCAL_URL=http://127.0.0.1:11434
CARCUE_DB=./carcue.sqlite3
CARCUE_SESSION_MINUTES=120
CARCUE_SESSION_REQUEST_LIMIT=30
CARCUE_GLOBAL_REQUEST_LIMIT=200
# 무료 로컬 AI는 OLLAMA_LOCAL을 명시해 사용합니다. 유료 자동 전환은 없습니다.
# 아래 OpenAI 어댑터 설정은 보존하지만 현재 실행 factory에서는 선택하지 않습니다.
OPENAI_API_KEY=
OPENAI_MODEL=
