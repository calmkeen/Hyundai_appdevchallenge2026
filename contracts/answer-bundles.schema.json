{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carcue.invalid/contracts/answer-bundles.schema.json",
  "type": "object", "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "bundles": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "policy_id": {"type": "string", "minLength": 1},
        "guide_id": {"type": "string", "minLength": 1},
        "profile_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "manual_set_id": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "topic": {"const": "door"},
        "unit_suffix": {"const": ":closing-bundle:v1"},
        "source_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "required_steps": {"type": "array", "minItems": 2, "maxItems": 2, "items": {
          "type": "object", "additionalProperties": false,
          "properties": {"step_id": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
          "required": ["step_id", "order", "source_ids"]
        }},
        "records": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "properties": {"locale": {"type": "string", "minLength": 2}, "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "required": ["locale", "payload_sha256", "bundle_sha256"]
        }},
        "content_basis": {"const": "PUBLISHED_CARCUE_REVIEWED_SUMMARIES"},
        "review_method": {"type": "string", "minLength": 1},
        "human_certified_review": {"const": false},
        "oem_approved": {"const": false}
      },
      "required": ["policy_id", "guide_id", "profile_ids", "manual_set_id", "source_version", "topic", "unit_suffix", "source_ids", "locales", "required_steps", "records", "content_basis", "review_method", "human_certified_review", "oem_approved"]
    }}
  },
  "required": ["schema_version", "bundles"]
}
